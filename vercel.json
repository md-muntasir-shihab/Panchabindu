{
  "installCommand": "npx --yes pnpm@10.34.9 install --frozen-lockfile",
  "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then npx --yes pnpm@10.34.9 run db:initialize-runtime || exit 1; fi; PORT=3000 BASE_PATH=/ npx --yes pnpm@10.34.9 run build:vercel",
  "outputDirectory": "artifacts/panchabindu/dist/public",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "artifacts/api-server/dist/**"
    },
    "api/**/*.mjs": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/cron/courier-status", "destination": "/api/courier-status-cron.mjs" },
    { "source": "/api/vendor/overview", "destination": "/api/vendor-overview.mjs" },
    { "source": "/api/:group/:path*", "destination": "/api/__gateway?__pb_group=:group&__pb_path=:path*" },
    { "source": "/manifest.webmanifest", "destination": "/api/__metadata/manifest.webmanifest" },
    { "source": "/sitemap.xml", "destination": "/api/__metadata/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api/__metadata/robots.txt" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
