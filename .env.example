# ============================================================================
# BONGOCONSIGN — MULTI-VENDOR CONSIGNMENT STORE & ERP (.env.example)
# Rule: NEVER commit real secrets here. All paid/external integrations are
# No production readiness is implied. Production identity/SMS remain NOT_INTEGRATED.
# ============================================================================

# 1. Runtime & App URLs
APP_URL="http://localhost:3000"
# Pin the exact public origin for production CSRF checks; no path or wildcard.
# Local sandbox identity only; never enable on an exposed or production dataset.
PANCHAGARH_ENABLE_SANDBOX_AUTH="0"
# Enable only behind a verified proxy that strips client-supplied IP headers.
PANCHAGARH_TRUST_PROXY_HEADERS="0"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"

# 2. Supabase (PostgreSQL + RLS + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# SERVER-ONLY: Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
PANCHAGARH_PERSISTENCE="local"


# 3. Server-Side Credentials Encryption Key (32-byte hex for AES-256-GCM)
# Used by Super Admin Credentials Manager to encrypt courier/SMS keys at rest
CREDENTIALS_ENCRYPTION_KEY=""

# 4. Internal Username-to-Email Auth Domain Mapping
AUTH_INTERNAL_EMAIL_DOMAIN="staff.internal.local"

# 5. Optional Upstash Redis (Free Tier Rate Limiting & Cache)
# Falls back to PostgreSQL idempotency_keys table if omitted
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 6. Optional Courier Adapters (Managed via Admin Credentials UI or env)
# Status shows "Not Connected — Setup Guide" when empty; Manual + CSV mode is always active
STEADFAST_API_BASE_URL="https://portal.packzy.com/api/v1"
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_WEBHOOK_SECRET=""

PATHAO_API_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_WEBHOOK_SECRET=""


# 7. Optional Messaging Adapters (Free wa.me & sms: deep-links work without keys)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@yourdomain.com"

TEXTBEE_API_BASE_URL="https://api.textbee.dev/api/v1"
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""

# Optional Paid WhatsApp Cloud API (OFF by default in Admin Trigger Matrix)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_VERIFY_TOKEN=""

# 8. Optional Google Sheets One-Way Mirror & Cron Security
GOOGLE_SHEETS_APPS_SCRIPT_URL=""
GOOGLE_SHEETS_SHARED_SECRET=""
CRON_SECRET="your-cron-hmac-secret"

# 9. Platform Gemini Key (Injected by runtime if needed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
