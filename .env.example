# Copy this file to .env.local for local development.
# Never commit real credentials.

APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Use PostgreSQL/Supabase in production. Do not use local persistence on Vercel.
PANCHAGARH_PERSISTENCE=postgres
PANCHAGARH_ENABLE_SANDBOX_AUTH=0
PANCHAGARH_TRUST_PROXY_HEADERS=0

# Generate unique random values for these; do not reuse Supabase keys.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key
CRON_SECRET=replace-with-a-long-random-secret

# Optional integrations
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_SECRET=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_WEBHOOK_SECRET=
REDX_ACCESS_TOKEN=
RESEND_API_KEY=
TEXTBEE_API_KEY=
GOOGLE_SHEETS_APPS_SCRIPT_URL=
GOOGLE_SHEETS_SHARED_SECRET=
