# ── Observability (optional) ────────────────────────────────────────────────
# Server-side error reporting for the API/Vercel functions. Leave empty to disable:
# every code path is a no-op without a DSN and the deployment behaves exactly as before.
SENTRY_DSN=
# 0 = errors only (default), 0.1 = trace 10% of requests.
SENTRY_TRACES_SAMPLE_RATE=0
# Browser-side reporting for the storefront + admin panel. Read at BUILD time, so it
# must be present when Vercel builds the frontend.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
